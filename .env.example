# Copy to .env on D:\ScholarSync_AI and edit as needed.
SCHOLARSYNC_PROVIDER=template
SCHOLARSYNC_OLLAMA_BASE_URL=http://127.0.0.1:11434
SCHOLARSYNC_OLLAMA_MODEL=qwen2.5:7b
SCHOLARSYNC_OLLAMA_EMBED_MODEL=nomic-embed-text
SCHOLARSYNC_EMBEDDING_PROVIDER=chroma-default
SCHOLARSYNC_GROQ_API_KEY=
SCHOLARSYNC_OPENALEX_API_KEY=
SCHOLARSYNC_GROQ_MODEL=openai/gpt-oss-20b
SCHOLARSYNC_MAX_CONTEXT_TOKENS=8192
SCHOLARSYNC_MAX_OUTPUT_TOKENS=1200
SCHOLARSYNC_REQUEST_TIMEOUT=45
SCHOLARSYNC_DATA_DIR=./data
SCHOLARSYNC_CACHE_TTL_HOURS=24
SCHOLARSYNC_MAX_PDF_MB=25
SCHOLARSYNC_MAX_PDF_PAGES=200
SCHOLARSYNC_MAX_RETRIES=2
SCHOLARSYNC_USER_AGENT=ScholarSyncAI/1.0 (academic research tool)
